{
  "openapi": "3.1.0",
  "info": {
    "title": "Loulou AI",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Session-Subject",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Session-Subject"
            }
          },
          {
            "name": "X-Customer-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Customer-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "delete": {
        "summary": "End Session",
        "operationId": "end_session_v1_sessions__session_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "X-Session-Subject",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Session-Subject"
            }
          },
          {
            "name": "X-Customer-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Customer-Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Locale",
            "default": "ar"
          },
          "current_store_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Store Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "product_cards": {
            "items": {
              "$ref": "#/components/schemas/ProductCard"
            },
            "type": "array",
            "title": "Product Cards"
          },
          "store_cards": {
            "items": {
              "$ref": "#/components/schemas/StoreCard"
            },
            "type": "array",
            "title": "Store Cards"
          },
          "order": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderCard"
              },
              {
                "type": "null"
              }
            ]
          },
          "faq_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Faq Ids"
          },
          "quick_replies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Quick Replies"
          },
          "handoff": {
            "$ref": "#/components/schemas/Handoff"
          },
          "requires_login": {
            "type": "boolean",
            "title": "Requires Login",
            "default": false
          },
          "requires_order_number": {
            "type": "boolean",
            "title": "Requires Order Number",
            "default": false
          },
          "demo": {
            "type": "boolean",
            "title": "Demo",
            "default": false
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "session_id",
          "language",
          "answer"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Handoff": {
        "properties": {
          "requested": {
            "type": "boolean",
            "title": "Requested",
            "default": false
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Handoff"
      },
      "OrderCard": {
        "properties": {
          "order_number": {
            "type": "string",
            "title": "Order Number"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "status_label": {
            "type": "string",
            "title": "Status Label"
          },
          "tracking_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tracking Url"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_number",
          "status",
          "status_label",
          "tracking_url",
          "updated_at"
        ],
        "title": "OrderCard"
      },
      "ProductCard": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Price"
          },
          "original_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Price"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "store_id",
          "name",
          "description",
          "price",
          "original_price",
          "currency",
          "url",
          "image_url",
          "updated_at"
        ],
        "title": "ProductCard"
      },
      "StoreCard": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "url"
        ],
        "title": "StoreCard"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
