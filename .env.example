# Copy to .env. Development/demo runs locally and does not call OpenAI or Laravel.
ENVIRONMENT=development
PLANNER_MODE=demo
BACKEND_MODE=mock
AI_SERVICE_TOKEN=local-development-only-change-me-0123456789

# To use real AI with mock catalog: PLANNER_MODE=openai, BACKEND_MODE=mock.
# Choose a model available to your API project that supports Responses function calling.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=15
MAX_OUTPUT_TOKENS=1000

# Fill these when the Laravel read endpoints are ready, then BACKEND_MODE=laravel.
BACKEND_BASE_URL=
BACKEND_API_TOKEN=
BACKEND_STORES_PATH=/api/ai/stores
BACKEND_PRODUCTS_PATH=/api/ai/products/search
BACKEND_FAQ_PATH=/api/ai/faqs/search
BACKEND_ORDER_PATH=/api/ai/orders/{order_number}
BACKEND_TIMEOUT_SECONDS=5
ALLOWED_CATALOG_HOSTS=["demo.example"]
ALLOWED_TRACKING_HOSTS=["tracking.example"]

# International digits only, no +; blank means no WhatsApp URL is fabricated.
WHATSAPP_PHONE=

# Empty = single-process in-memory sessions (development only).
# Production requires Redis, protected on a private network with persistence disabled.
REDIS_URL=
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=1000
HISTORY_TURNS=8
REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=25
RECOMMENDATION_LIMIT=3
